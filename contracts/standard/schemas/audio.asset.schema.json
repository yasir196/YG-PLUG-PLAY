{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "media_type"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "pattern": "^audio/"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    }
  }
}
