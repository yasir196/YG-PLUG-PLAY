{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "media_type"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "pattern": "^image/"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    }
  }
}
