{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "topic",
    "goal",
    "language",
    "metadata"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "metadata": {
      "type": "object"
    }
  }
}
