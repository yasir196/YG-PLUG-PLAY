{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt"
  ],
  "properties": {
    "prompt": {
      "type": "string"
    },
    "aspect_ratio": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
