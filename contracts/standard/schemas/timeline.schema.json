{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration_seconds",
    "items"
  ],
  "properties": {
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "artifact_id"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "artifact_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
