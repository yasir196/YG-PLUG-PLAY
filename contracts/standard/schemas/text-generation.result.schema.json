{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Text Generation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "string"
    },
    "structured": {
      "type": "object"
    },
    "finish_reason": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
