{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-publish Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passed",
    "checks"
  ],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "passed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "passed": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "override_allowed": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    }
  }
}
